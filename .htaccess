# ==============================================================================
# Oriental Consultants Afghanistan — Server Configuration & 301 Redirects
# Primary Domain: https://ocafghan.com (non-www)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and 301 Redirect www.ocafghan.com to https://ocafghan.com
  # Preserves full URI path and query strings
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.ocafghan\.com$ [NC]
  RewriteRule ^(.*)$ https://ocafghan.com/$1 [R=301,L,QSA]

  # 2. Redirect legacy / alias URLs to canonical services
  RewriteRule ^microsoft-365\.html$ https://ocafghan.com/ict.html [R=301,L]
</IfModule>

# Custom 404 Error Document
ErrorDocument 404 /404.html

# Security & Performance Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
